/social-media/*
# The hub itself stays local (it holds OAuth client ids and a generated queue),
# but the Content Studio's source is real code and belongs in the repo. Its
# keys, media library and renders do not.
/social/*
!/social/STUDIO.md
!/social/studio.html
!/social/hub.mjs
!/social/studio.js
!/social/studio.css
!/social/auto.html
!/social/auto.js
!/social/auto.css
!/social/cut.html
!/social/cut.js
!/social/cut.css
!/social/blitz.html
!/social/blitz.js
!/social/blitz.css
!/social/out.html
!/social/out.js
!/social/out.css
!/social/editor.html
!/social/editor.js
!/social/editor.css
!/social/studio-server.mjs
!/social/studio.config.example.json
!/social/studio/
/social/studio/*
!/social/studio/*.js
!/social/studio/*.mjs
!/social/studio/formats.json
/marketing-video-15-agustos/*
/marketing-video-2/*
/marketing-video-3/*
/scripts/*
# wrangler local cache/state in any worker directory
.wrangler/

# marketing-video-* moved under videos/; same split as before the move —
# render.mjs is source, preview.mjs and out/ are generated.
videos/*/out/
videos/*/preview.mjs
# The compare clip's capture script is tuned per render (type sizes for the
# feed it is going to), so it is kept local rather than committed half-tuned.
videos/compare-video/capture.mjs
videos/video-screenshots/
videos/*.png
# social-media-video/: the app screenshots are sources (scripts/og-card.html
# reads shot-home.png); the shorts PNGs are rendered from the SVGs beside them.
social-media-video/shorts/*.png
